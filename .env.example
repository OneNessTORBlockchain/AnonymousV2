# Anonymous V2 configuration.
#
# Copy this file to .env and fill in the key (or use the Provider panel in the
# UI, which writes the same keys).  .env is git-ignored: never commit a real key.
#
# Provider labels:
#   openai | venice | openai-compatible  -> POST {base}/chat/completions
#   ollama | ollama-local | ollama-cloud -> native POST {base}/api/chat
#   anything else                        -> decided by a /v1 suffix on the base URL
# Ollama Cloud must use "openai": its native /api/tags path serves model metadata,
# not the cloud chat endpoint.  The ":cloud" suffix is part of the routable id.
AV2_LLM_PROVIDER=openai
AV2_OLLAMA_BASE_URL=https://ollama.com/v1
AV2_OLLAMA_API_KEY=

AV2_PLANNER_MODEL=deepseek-v4.1-flash:cloud
AV2_WORKER_MODEL=deepseek-v4.1-flash:cloud
# Comma-separated list; agents are spread over it round-robin.
AV2_FLEET_MODELS=deepseek-v4.1-flash:cloud

AV2_PLANNER_NUM_CTX=131072
AV2_WORKER_NUM_CTX=131072

# Squads of five (recon, web, exploit, coder, reporter): 1-5 => 5/10/15/20/25.
AV2_FLEET_GROUPS=1
# Rounds for a normal turn, and the ceiling for "until complete".
AV2_FLEET_ROUNDS=2
AV2_FLEET_MAX_ROUNDS=50
