# Anonymous V2 - keep secrets and runtime state out of git.

# --- secrets ---------------------------------------------------------------
.env
.env.*
!.env.example
*.bak-*
artex/.env
artex*/.env

# --- python ----------------------------------------------------------------
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
*.egg-info/

# --- runtime state ---------------------------------------------------------
storage/
tmp/
*.log
